# Copiar a .env.local y completar. NUNCA subir .env.local a Git.

# ── Públicas (se exponen al navegador) ──────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://<proyecto>.supabase.co
# Key pública (anon / publishable). Segura en el cliente SOLO si RLS está activo.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_BASE_URL=https://karaokerock.com.ve

# ── Secretas (solo servidor) ────────────────────────────────
# service_role / secret key: salta RLS. Jamás con prefijo NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
RESEND_API_KEY=
RESEND_FROM=info@takariwa.studio

# Hash scrypt del password admin. Generar con:
#   npm run hash-password -- "<password de 12+ caracteres>"
ADMIN_PASSWORD_HASH=
# Firma de la cookie de sesión admin (32+ caracteres aleatorios). Generar con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
ADMIN_SESSION_SECRET=
# Clave AES-256 para cifrar cédula/teléfono/email (32 bytes base64). Generar con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# ¡Guardarla en un lugar seguro! Si se pierde, los datos cifrados no se recuperan.
DATA_ENCRYPTION_KEY=
